# Copiá este archivo a .env.local. Todo es opcional para correr local:
# sin DATABASE_URL se usa PGlite en .data/ y sin proveedores se activa el modo demo.

# Base de datos (Neon o Supabase). Ej.: postgres://usuario:clave@host/db?sslmode=require
DATABASE_URL=

# URL pública del sitio (links en mails, QR, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sal para hashear IPs en los límites de uso. Cualquier texto largo y aleatorio.
AUTH_SECRET=

# Modo demo: muestra en pantalla el enlace mágico y el código SMS. NUNCA en un sitio con usuarios reales.
DEMO_MODE=

# Enlace mágico por mail (https://resend.com, plan gratis)
RESEND_API_KEY=
EMAIL_FROM="Changa <hola@tu-dominio.com>"

# Ingreso con Google (console.cloud.google.com → Credenciales → ID de cliente OAuth)
# URI de redirección autorizada: {NEXT_PUBLIC_SITE_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Verificación de celular por SMS (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Cloudflare Turnstile (anti-spam, gratis)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
